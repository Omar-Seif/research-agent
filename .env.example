GROQ_API_KEY=
MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

API_PREFIX=/api
DEBUG=True

# Must be a valid JSON array, e.g. ["https://a.com","https://b.com"]
ALLOWED_ORIGINS=["https://localhost:3000", "https://localhost:5173"]

LOG_LEVEL=DEBUG

REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=1